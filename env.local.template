# Kobe.ai local settings.
# 1. Copy this file to ".env.local" (with the leading dot). Next.js only loads that name, and git ignores it.
# 2. Fill in what you need. Every value is optional: with nothing set, Kobe runs the offline demo.

# Any Postgres 15+. On Neon: Console → Connect → Postgres tab. Paste the string as copied.
DATABASE_URL=""

# Live agent. Neon Console → Connect → AI Gateway tab → Reveal credential (starts with nt_live_).
NEON_AI_GATEWAY_TOKEN=""
# The AI Gateway host for your branch, from the same tab.
NEON_AI_GATEWAY_BASE_URL="https://<branch>-api.ai.<cell>.<region>.aws.neon.tech"

# Optional: any model ID from https://neon.com/models with the "neon/" prefix.
KOBE_MODEL="neon/gpt-oss-120b"

# Required on a production server (next start, Docker): the password for the browser sign-in.
# Without it, production serves the offline demo only. `pnpm dev` does not need it.
KOBE_PASSWORD=""

# Optional. Gmail search and drafts. An OAuth access token with gmail.modify.
# Sending still waits for an explicit confirm. Leave blank to keep Gmail disconnected.
GMAIL_ACCESS_TOKEN=""

# Optional. Slack search and drafts. A user token (xoxp-) that can search and post as you.
# Sending still waits for an explicit confirm. Leave blank to keep Slack disconnected.
SLACK_USER_TOKEN=""
